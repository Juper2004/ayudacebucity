# Copy this file to .env and fill in private values locally.
HOST=127.0.0.1
PORT=3000
APP_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
DATABASE_PATH=./data/ayuda.sqlite

# Required: generate 32 random bytes as 64 hex characters:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
OTP_SECRET=

# Creates the first DSWS administrator; does not reset an existing account.
ADMIN_NAME="DSWS Administrator"
ADMIN_EMAIL=jupernavarro63@gmail.com
ADMIN_PASSWORD=navarro16

# Gmail testing: enable 2-Step Verification and create an App Password.
# Use the sender's full Gmail address for SMTP_USER and MAIL_FROM.
# SMTP_PASS is the App Password, with any display spaces removed.
MAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=jupernavarro63@gmail.com
SMTP_PASS=qxhp rdzf elma acmw
MAIL_FROM=jupernavarro63@gmail.com

# Optional alternative: set MAIL_PROVIDER=resend and configure this key
# plus a MAIL_FROM address authorized by your Resend account.
RESEND_API_KEY=
