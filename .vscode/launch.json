{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "chrome",
            "request": "launch",
            "name": "Launch AYUDA in Chrome",
            "url": "http://localhost:3000",
            "webRoot": "${workspaceFolder}"
        },
        {
            "type": "node",
            "request": "launch",
            "name": "Launch AYUDA backend and Chrome",
            "program": "${workspaceFolder}/server/index.cjs",
            "cwd": "${workspaceFolder}",
            "runtimeArgs": ["--env-file-if-exists=.env"],
            "console": "internalConsole",
            "skipFiles": ["<node_internals>/**"],
            "serverReadyAction": {
                "pattern": "(https?://(?:localhost|127\\.0\\.0\\.1):[0-9]+)",
                "uriFormat": "%s",
                "action": "debugWithChrome",
                "webRoot": "${workspaceFolder}"
            }
        }
    ]
}
